+def build_pisg_layerwise_options(
+    bias_good: jax.Array,
+    bias_bad: jax.Array,
+    pisg_layer_indices: tuple[int, ...] | None,
+    num_decoder_layers: int,
+    softcap: float | None,
+    sm_scale: float | None = None,
+    bias_dtype: jax.typing.DTypeLike | None = None,
+) -> list[dict]:
+    if bias_dtype is not None:
+        bias_good = bias_good.astype(bias_dtype)
+        bias_bad = bias_bad.astype(bias_dtype)
+    bias_pisg = jnp.concatenate([bias_good, bias_bad], axis=0)
+    bias_normal = jnp.concatenate([bias_good, bias_good], axis=0)
+    options: list[dict] = []
+    for i in range(num_decoder_layers):
+        d: dict = {'softcap': softcap}
+        if sm_scale is not None:
+            d['sm_scale'] = sm_scale
+        d['bias'] = bias_pisg if (pisg_layer_indices is None or i in pisg_layer_indices) else bias_normal
+        options.append(d)
+    return options
+
+
+def build_layerwise_attention_options(
+    bias_default: jax.Array | None,
+    bias_selected: jax.Array | None,
+    selected_layers: tuple[int, ...] | None,
+    num_layers: int,
+    softcap: float | None,
+    sm_scale: float | None = None,
+    bias_dtype: jax.typing.DTypeLike | None = None,
+    segment_ids: jax.Array | None = None,
+    selected_extra: dict | None = None,
+) -> list[dict]:
+    if bias_default is not None and bias_dtype is not None:
+        bias_default = bias_default.astype(bias_dtype)
+    if bias_selected is not None and bias_dtype is not None:
+        bias_selected = bias_selected.astype(bias_dtype)
+
+    options: list[dict] = []
+    for i in range(num_layers):
+        d: dict = {'softcap': softcap}
+        if sm_scale is not None:
+            d['sm_scale'] = sm_scale
+        if segment_ids is not None:
+            d['segment_ids'] = segment_ids
+
+        use_selected = selected_layers is None or i in selected_layers
+        d['bias'] = bias_selected if use_selected else bias_default
+        if use_selected and selected_extra is not None:
+            d.update(selected_extra)
+        options.append(d)
+    return options
